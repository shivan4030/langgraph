--- jsonplus.py
+++ jsonplus.py
@@ -50,14 +50,14 @@
 logger = logging.getLogger(__name__)

 class _RestrictedUnpickler(pickle.Unpickler):
-    def __init__(self, *args: Any, allowed_modules: set[tuple[str, ...]] | Literal[True], **kwargs: Any) -> None:
+    def __init__(self, *args: Any, allowed_modules: set[tuple[str, ...]] | Literal[True] | None, **kwargs: Any) -> None:
         super().__init__(*args, **kwargs)
-        self.allowed_modules = allowed_modules
+        self.allowed_modules = allowed_modules if allowed_modules is not None else set()

     def find_class(self, module: str, name: str) -> Any:
         if self.allowed_modules is True:
             return super().find_class(module, name)
         parts = tuple(module.split("."))
         for i in range(1, len(parts) + 1):
             if parts[:i] in self.allowed_modules:
                 return super().find_class(module, name)
